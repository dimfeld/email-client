{
	"name": "email-check",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun --env-file .env vite dev",
		"build": "vite build",
		"start": "bun build/index.js",
		"app": "bun run build && bun build/index.js",
		"accounts:discover": "bun scripts/accounts-discover.ts",
		"account:configure": "bun scripts/account-configure.ts",
		"watch:start": "bun scripts/watch-start.ts",
		"watch:renew": "bun scripts/watch-renew.ts",
		"sync": "bun scripts/sync.ts",
		"sync:google": "bun scripts/google-sync.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/bun": "^1.4.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.71",
		"@google-cloud/pubsub": "^6.1.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@typesafe-ai/sdk": "^0.6.0",
		"ai": "^7.0.107",
		"zod": "^4.6.5"
	}
}
