{
  "name": "email-check",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun --env-file .env vite dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "vite build",
    "lint": "oxlint .",
    "start": "bun scripts/start.ts",
    "app": "bun run build && bun run start",
    "pubsub:setup": "bun scripts/pubsub-setup.ts",
    "account:configure": "bun scripts/account-configure.ts",
    "watch:start": "bun scripts/watch-start.ts",
    "watch:renew": "bun scripts/watch-renew.ts",
    "sync": "bun scripts/sync.ts",
    "sync:google": "bun scripts/google-sync.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.71",
    "@google-cloud/pubsub": "^6.1.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@tiptap/core": "~3.31.3",
    "@tiptap/extension-image": "~3.31.3",
    "@tiptap/extension-text-align": "~3.31.3",
    "@tiptap/markdown": "~3.31.3",
    "@tiptap/pm": "~3.31.3",
    "@tiptap/starter-kit": "~3.31.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.107",
    "google-auth-library": "^11.1.0",
    "nodemailer": "~10.0.10",
    "sanitize-html": "~2.17.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/bun": "^1.4.2",
    "@types/mailparser": "~3.4.6",
    "@types/nodemailer": "~8.0.2",
    "@types/sanitize-html": "~2.16.1",
    "mailparser": "~3.9.28",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
