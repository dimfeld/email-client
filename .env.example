# TypeSafe uses TYPESAFE_API_KEY.
TYPESAFE_API_KEY=

# Enables GPT-5.6 Luna extraction for messages that Jev marks as action items or reminders.
OPENAI_API_KEY=

DATABASE_PATH=data/email-check.sqlite
PORT=3000

# Path to the downloaded OAuth client JSON file.
GOOGLE_OAUTH_CLIENT_FILE=
# Or set the client values directly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
