# TypeSafe uses TYPESAFE_API_KEY.
TYPESAFE_API_KEY=

# Enables email chat and GPT-5.6 Luna extraction for action items and reminders.
OPENAI_API_KEY=
# Optional chat model override; uses the existing GPT-5.6 Luna model when unset.
EMAIL_CHAT_MODEL=

DATABASE_PATH=data/email-check.sqlite
PORT=3000

# Path to the downloaded OAuth client JSON file.
GOOGLE_OAUTH_CLIENT_FILE=
# Or set the client values directly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
