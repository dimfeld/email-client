# TypeSafe uses TYPESAFE_API_KEY. JEV_API_KEY is also supported for local compatibility.
TYPESAFE_API_KEY=
# JEV_API_KEY=

# Optional webhook protection. Use the same value for the app and gog hook calls.
GMAIL_HOOK_TOKEN=

DATABASE_PATH=data/email-check.sqlite
PORT=3000
APP_URL=http://127.0.0.1:3000
